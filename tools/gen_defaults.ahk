#Requires AutoHotkey v2.0
#Warn All, Off
#Include ..\Lib\JSON.ahk
#Include ..\core\ConfigManager.ahk

; Single source of truth for default settings is core\ConfigManager.ahk.
; This script mirrors the sections the settings UI needs into web\js\defaults.js
; so the two cannot drift apart.
;
; Usage:
;   AutoHotkey64.exe tools\gen_defaults.ahk         ; regenerate defaults.js
;   AutoHotkey64.exe tools\gen_defaults.ahk check   ; exit 1 when outdated

defaults := ConfigManager.GetDefaultConfig()

; Legacy top-level keys (titleBar, workspaces, rules, altTab) are AHK-only and
; intentionally not exposed to the settings UI.
filtered := Map(
    "language", defaults["language"],
    "hotkeys", defaults["hotkeys"],
    "general", defaults["general"],
    "appearance", defaults["appearance"]
)

content := "// AUTO-GENERATED by tools/gen_defaults.ahk from core/ConfigManager.ahk.`n"
content .= "// Do not edit by hand: run tools/gen_defaults.ahk to regenerate.`n"
content .= "const DEFAULT_CONFIG = " PrettyJS(filtered) ";`n`n"
content .= "window.DEFAULT_CONFIG = DEFAULT_CONFIG;`n"

targetPath := A_ScriptDir "\..\web\js\defaults.js"

if (A_Args.Length && A_Args[1] == "check") {
    if FileExist(targetPath) && (FileRead(targetPath, "UTF-8") == content) {
        Say("defaults.js is up to date.")
        ExitApp(0)
    }
    Say("defaults.js is outdated: run tools\gen_defaults.ahk")
    ExitApp(1)
}

FileDelete(targetPath)
FileAppend content, targetPath, "UTF-8-RAW"
Say("Generated " targetPath)
ExitApp(0)

; A script started without a console has no stdout handle; writing to "*"
; then throws "The handle is invalid". Exit codes are the real contract.
Say(text) {
    try FileAppend(text "`n", "*")
}

Indent(level) {
    pad := ""
    Loop level
        pad .= "  "
    return pad
}

PrettyJS(value, level := 0) {
    if (value is Map) {
        if (value.Count = 0)
            return "{}"
        inner := Indent(level + 1)
        body := ""
        for k, v in value
            body .= (body != "" ? ",`n" : "") . inner . '"' . k . '": ' . PrettyJS(v, level + 1)
        return "{`n" . body . "`n" . Indent(level) . "}"
    }

    if (value is Array) {
        if (value.Length = 0)
            return "[]"
        inner := Indent(level + 1)
        body := ""
        for v in value
            body .= (body != "" ? ",`n" : "") . inner . PrettyJS(v, level + 1)
        return "[`n" . body . "`n" . Indent(level) . "]"
    }

    return JSON.Dump(value)
}
